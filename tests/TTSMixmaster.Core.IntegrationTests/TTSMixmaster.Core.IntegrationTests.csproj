<Project Sdk="MSTest.Sdk">

  <!--
    Integration layer: real filesystem, real yt-dlp/ffmpeg (fetched into tests/.tools by
    scripts/fetch-tools.ps1) and Azurite when present. Every test is [TestCategory("Integration")];
    a test whose dependency is missing ends Inconclusive with the reason. No cloud services or credentials.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Program.cs owns Main: it applies NoCrashDialogs before the host starts. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <!-- Where scripts/fetch-tools.ps1 puts yt-dlp/ffmpeg for tests (override: TTSMIXMASTER_TEST_TOOLS). -->
    <AssemblyMetadata Include="TestToolsDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\.tools'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TTSMixmaster.Core\TTSMixmaster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Crashes end with an exit code, never a WER dialog on the desktop (inherited by child processes). -->
    <Compile Include="..\Shared\NoCrashDialogs.cs" Link="Shared\NoCrashDialogs.cs" />
  </ItemGroup>

</Project>
