<Project Sdk="MSTest.Sdk">

  <!--
    WinUI UI-thread tests for TTSMixmaster.App. Started from `winapp new -t winui-unittest`, then moved to
    MSTest.Sdk on Microsoft.Testing.Platform (MSTest 4.5+): the project is itself a small self-hosted,
    unpackaged WinUI app (UnitTestApp) that creates a window, hands its dispatcher to [UITestMethod] and
    runs the MTP host. It matches the App's deployment: unpackaged, Windows App SDK self-contained, x64/ARM64.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TTSMixmaster.App.Tests</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <!-- RID follows the requested Platform (so an ARM64 build on an x64 host works), else the host. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The App is a self-contained exe; a project referencing it must be self-contained too (NETSDK1151). -->
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="UnitTestApp.xaml" />
    <ApplicationDefinition Include="UnitTestApp.xaml" />
    <ProjectCapability Include="TestContainer" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as src/TTSMixmaster.App. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TTSMixmaster.App\TTSMixmaster.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Crashes end with an exit code, never a WER dialog on the desktop (inherited by child processes). -->
    <Compile Include="..\Shared\NoCrashDialogs.cs" Link="Shared\NoCrashDialogs.cs" />
  </ItemGroup>

</Project>
