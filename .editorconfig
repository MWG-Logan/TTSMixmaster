# Code style for TTSMixmaster. Conventions: AGENTS.md "Conventions". Line endings: LF everywhere,
# matching .gitattributes (`* text=auto eol=lf`).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,xaml,appxmanifest,manifest,pubxml,config,resw}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

# Golden files are byte-exact legacy output; never reformat them.
[tests/TTSMixmaster.Core.Tests/Tts/golden/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
charset = unset

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# var: use it when the type is apparent or built in; elsewhere either is fine
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Braces: optional for single-line statements, required when the statement spans lines
csharp_prefer_braces = when_multiline:suggestion

# Modern C#
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Formatting
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Naming: _camelCase private fields, PascalCase constant fields and static readonly fields, I-prefixed interfaces.
# (The Async suffix convention is reviewed, not enforced: test methods and event handlers are exempt.)
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, interface

dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.i_pascal.required_prefix = I
dotnet_naming_style.i_pascal.capitalization = pascal_case

# The most specific rule wins, so constants and static readonly fields are PascalCase, other private fields _camelCase.
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.interfaces_i.symbols = interfaces
dotnet_naming_rule.interfaces_i.style = i_pascal
dotnet_naming_rule.interfaces_i.severity = warning
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning

# Build enforcement of the naming rules above needs an explicit IDE1006 severity.
dotnet_diagnostic.IDE1006.severity = warning

# Unused usings (IDE0005) needs GenerateDocumentationFile to report in builds; keep it an IDE hint.
dotnet_diagnostic.IDE0005.severity = suggestion

# ---------------------------------------------------------------------------------------------
# .NET analyzer tuning (AnalysisLevel latest-recommended, see Directory.Build.props).
# Each downgrade has a one-line reason; everything else stays at the recommended severity.
# ---------------------------------------------------------------------------------------------
[*.cs]
# App-lifetime view models/services own a CancellationTokenSource or SemaphoreSlim without timers
# or wait handles; there is nothing unmanaged to release and no owner that would call Dispose.
dotnet_diagnostic.CA1001.severity = suggestion
# Domain names from GLOSSARY.md (MusicCollection, AzurePermission), not misnamed collection/permission types.
dotnet_diagnostic.CA1711.severity = none
# Members stay instance for x:Bind, [RelayCommand] and interface/test seams; static gains nothing here.
dotnet_diagnostic.CA1822.severity = suggestion
# Return types are deliberately the abstraction (TokenCredential, IReadOnlyList); perf is irrelevant there.
dotnet_diagnostic.CA1859.severity = suggestion
# Constant arrays sit in cold paths (one-off setup, tool arguments); hoisting them hurts readability.
dotnet_diagnostic.CA1861.severity = suggestion

[tests/**.cs]
# MSTest names are sentences with underscores (AGENTS.md test conventions).
dotnet_diagnostic.CA1707.severity = none
# Fakes throw plain Exception on purpose: the code under test must handle any exception type.
dotnet_diagnostic.CA2201.severity = none
# Test assertions compare ASCII literals; culture can't change the result and the noise hides real hits.
dotnet_diagnostic.CA1310.severity = suggestion
# One-shot test helpers: a cached JsonSerializerOptions or a checked TryParse adds nothing.
dotnet_diagnostic.CA1869.severity = suggestion
dotnet_diagnostic.CA1806.severity = suggestion

[src/TTSMixmaster.Core/Tts/TtsExporter.cs]
# ExportToTtsAsync has an optional thumbnail after ct; reordering would break positional callers on
# branches in flight. Reorder once they merge, then drop this override.
dotnet_diagnostic.CA1068.severity = suggestion
