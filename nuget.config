<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from nuget.org, regardless of machine-level feeds. <clear /> leaves exactly one source,
  so Central Package Management doesn't raise NU1507 and no package source mapping is needed.
  (Don't add a mapping: azure/artifact-signing-action installs its tools with `dotnet tool install
  add-source`, which NuGet refuses while package source mapping is active.)
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
