<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TTSMixmaster.App.Views.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:TTSMixmaster.App.Helpers"
    xmlns:local="using:TTSMixmaster.App.Views"
    xmlns:vm="using:TTSMixmaster.App.ViewModels">

    <Page.Resources>
        <!--
            Column widths shared by the header row and every track row: # | title (star) | length | status.
            Length and status are fixed and right-aligned, so they sit at the list's right edge at any width.
            The status column fits a 20px ring with room to spare (and the "Status" heading).
        -->
        <GridLength x:Key="NumberColumn">40</GridLength>
        <GridLength x:Key="LengthColumn">64</GridLength>
        <GridLength x:Key="StatusColumn">48</GridLength>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: what this is, and the one thing to do with it.  -->
        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="56"
                Height="56"
                VerticalAlignment="Top"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <ImageIcon
                    Width="30"
                    Height="30"
                    Source="{x:Bind h:Bind.ServiceIcon(ViewModel.Service), Mode=OneTime}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    AutomationProperties.AutomationId="CollectionTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.AutomationId="BuildButton"
                    AutomationProperties.Name="Build for Tabletop Simulator"
                    Command="{x:Bind ViewModel.BuildCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Download the audio, upload it to Azure, and generate the Tabletop Simulator files"
                    Visibility="{x:Bind ViewModel.ShowBuild, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                        <TextBlock Text="Build for Tabletop Simulator" />
                    </StackPanel>
                </Button>
                <!--  After a build, Copy Lua script is the next step, so rebuilding steps back to a standard button.  -->
                <Button
                    AutomationProperties.AutomationId="RebuildButton"
                    AutomationProperties.Name="Build again"
                    Command="{x:Bind ViewModel.BuildCommand}"
                    ToolTipService.ToolTip="Build the music player again, for example after changing the Tabletop object options"
                    Visibility="{x:Bind ViewModel.ShowRebuild, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="Build again" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="CancelBuildButton"
                    Command="{x:Bind ViewModel.BuildCancelCommand}"
                    Content="Cancel build"
                    Visibility="{x:Bind ViewModel.IsBuilding, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  Live status stays pinned above the scrolling list.  -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Border
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.IsBuilding, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock
                            AutomationProperties.AutomationId="BuildStep"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.StepText, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.StepDetail, Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        AutomationProperties.Name="Build progress"
                        IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                        Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                        Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <InfoBar
                AutomationProperties.AutomationId="BuildResult"
                IsOpen="{x:Bind ViewModel.IsResultOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsResultOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" />
        </StackPanel>

        <ListView
            x:Name="TrackList"
            Grid.Row="2"
            Margin="-16,8,-16,0"
            Padding="0,0,0,24"
            AutomationProperties.AutomationId="TrackList"
            AutomationProperties.Name="Tracks"
            ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneTime}"
            SelectionMode="None">
            <ListView.Header>
                <StackPanel Margin="16,0,16,0" Spacing="8">
                    <InfoBar
                        AutomationProperties.AutomationId="LoadError"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                        Severity="Error"
                        Title="Couldn't open this collection">
                        <InfoBar.ActionButton>
                            <Button
                                AutomationProperties.AutomationId="RetryLoad"
                                Command="{x:Bind ViewModel.RetryLoadCommand}"
                                Content="Try again" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        AutomationProperties.AutomationId="ToolsProblem"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasToolsProblem, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasToolsProblem, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ToolsProblem, Mode=OneWay}"
                        Severity="Error"
                        Title="Audio tools are missing" />
                    <InfoBar
                        AutomationProperties.AutomationId="AzureMissing"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsAzureMissing, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsAzureMissing, Mode=OneWay}"
                        Message="{x:Bind ViewModel.AzureProblem, Mode=OneWay}"
                        Severity="Warning"
                        Title="Azure Storage isn't ready">
                        <InfoBar.ActionButton>
                            <Button
                                AutomationProperties.AutomationId="OpenSettingsFromAzure"
                                Click="OpenSettings_Click"
                                Content="Open Settings" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!--  After a build: get it into the game. Export to TTS is the one primary action.  -->
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Put it in Tabletop Simulator" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Export adds the music player to your Saved Objects. In Tabletop Simulator, open Objects → Saved Objects → TTSMixmaster and click it to place it."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="ExportToTtsButton"
                                    Command="{x:Bind ViewModel.ExportToTtsCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xEDE1;" />
                                        <TextBlock Text="Export to TTS" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.AutomationId="OpenOutputFolderButton" Command="{x:Bind ViewModel.OpenOutputFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                                        <TextBlock Text="Open output folder" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="MoreOutputActions"
                                    AutomationProperties.Name="More"
                                    ToolTipService.ToolTip="More">
                                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="CopyLuaMenuItem"
                                                Command="{x:Bind ViewModel.CopyLuaCommand}"
                                                Text="Copy Lua script">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="CopyStatus"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" />
                            </StackPanel>

                            <local:ExportResultBar ViewModel="{x:Bind ViewModel.ExportState, Mode=OneTime}" />

                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="ObjectOptions"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <Expander.Header>
                            <StackPanel Padding="0,12">
                                <TextBlock Text="Tabletop object" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Chip image, name and description for the music player. All optional." />
                            </StackPanel>
                        </Expander.Header>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Chip preview: Core's render, byte for byte the image that is uploaded with the
                                build. It depicts the physical chip, so it looks the same in every theme.
                            -->
                            <StackPanel MaxWidth="240" Spacing="12">
                                <Grid
                                    Width="184"
                                    Height="184"
                                    HorizontalAlignment="Left">
                                    <ProgressRing
                                        AutomationProperties.Name="Drawing the chip preview"
                                        IsActive="{x:Bind h:Bind.Not(ViewModel.HasChipPreview), Mode=OneWay}" />
                                    <Image
                                        AutomationProperties.AutomationId="ChipPreview"
                                        AutomationProperties.Name="{x:Bind ViewModel.ChipPreviewDescription, Mode=OneWay}"
                                        Source="{x:Bind h:Bind.PngImage(ViewModel.ChipPng), Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Grid>
                                <TextBlock
                                    AutomationProperties.AutomationId="ChipImageError"
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="{x:Bind ViewModel.ChipImageError, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasChipImageError, Mode=OneWay}" />
                                <ToggleSwitch
                                    AutomationProperties.AutomationId="ShowTitleOnChip"
                                    Header="Show title on chip"
                                    IsOn="{x:Bind ViewModel.ShowTitleOnChip, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="UseCustomChipImage"
                                        Click="UseCustomChipImage_Click"
                                        Content="Use custom image…" />
                                    <Button
                                        AutomationProperties.AutomationId="RemoveCustomChipImage"
                                        AutomationProperties.Name="Remove custom image"
                                        Command="{x:Bind ViewModel.RemoveCustomChipImageCommand}"
                                        ToolTipService.ToolTip="Remove custom image"
                                        Visibility="{x:Bind ViewModel.HasCustomChipImage, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <TextBox
                                    AutomationProperties.AutomationId="ObjectNickname"
                                    Header="Name"
                                    PlaceholderText="{x:Bind ViewModel.Title, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.ObjectNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    AutomationProperties.AutomationId="ObjectDescription"
                                    Header="Description"
                                    PlaceholderText="Generated from the track list"
                                    Text="{x:Bind ViewModel.ObjectDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    AutomationProperties.AutomationId="PrimaryImageUrl"
                                    Header="Front image URL"
                                    InputScope="Url"
                                    PlaceholderText="Uses the chip image above"
                                    Text="{x:Bind ViewModel.PrimaryImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    AutomationProperties.AutomationId="SecondaryImageUrl"
                                    Header="Back image URL"
                                    InputScope="Url"
                                    PlaceholderText="Default music player image"
                                    Text="{x:Bind ViewModel.SecondaryImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <!--
                        Column headings. The header panel is inset 16 on both sides, list items 16 left / 12 right
                        (ListViewItem padding), so -4 on the right lines the headings up with the row columns.
                    -->
                    <Grid
                        Margin="0,16,-4,4"
                        AutomationProperties.AutomationId="TrackListHeader"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NumberColumn}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource LengthColumn}" />
                            <ColumnDefinition Width="{StaticResource StatusColumn}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="#" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Title" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Length" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Status" />
                    </Grid>
                    <ProgressRing
                        Margin="0,32,0,0"
                        AutomationProperties.AutomationId="TracksLoading"
                        AutomationProperties.Name="Loading tracks"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRowViewModel">
                    <Grid
                        Padding="0,8"
                        AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NumberColumn}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource LengthColumn}" />
                            <ColumnDefinition Width="{StaticResource StatusColumn}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Number, Mode=OneTime}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text="{x:Bind Artist, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  Why a track failed (or "Already downloaded"): under the title, where there's room to read it.  -->
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionStyle}"
                                MaxLines="2"
                                Text="{x:Bind ShortMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}"
                                Visibility="{x:Bind h:Bind.VisibleIfText(ShortMessage), Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Duration, Mode=OneTime}" />
                        <Grid
                            Grid.Column="3"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind AccessibleStatus, Mode=OneWay}">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                MinWidth="20"
                                MinHeight="20"
                                IsActive="{x:Bind h:Bind.IsWorkingActive(Status), Mode=OneWay}"
                                Visibility="{x:Bind h:Bind.IsWorking(Status), Mode=OneWay}" />
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind h:Bind.IsDone(Status), Mode=OneWay}" />
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xEA39;"
                                Visibility="{x:Bind h:Bind.IsFailed(Status), Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
