<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TTSMixmaster.App.Views.TtsHowTo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  How a build gets into a game. Export to TTS is the route; Copy Lua lives in each row's More menu.  -->
    <StackPanel Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="How to use in Tabletop Simulator" />
        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
            <Run Text="Choose Export to TTS on a build. Then, in Tabletop Simulator, open Objects &#x2192; Saved Objects &#x2192; TTSMixmaster and click the music player to place it at your cursor." />
        </TextBlock>
    </StackPanel>
</UserControl>
