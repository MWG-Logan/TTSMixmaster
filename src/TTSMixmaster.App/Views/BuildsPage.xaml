<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TTSMixmaster.App.Views.BuildsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:TTSMixmaster.App.Helpers"
    xmlns:local="using:TTSMixmaster.App.Views"
    xmlns:vm="using:TTSMixmaster.App.ViewModels">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource PageHeaderMargin}">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Builds" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button AutomationProperties.AutomationId="OpenBuildsFolder" Command="{x:Bind ViewModel.OpenOutputRootCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                        <TextBlock Text="Open builds folder" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="RefreshBuilds"
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Refresh">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            In progress: builds keep running while you look at other pages, so they're listed here (live) until
            they finish. One that ends without a player (failed, cancelled) stays until it's opened or dismissed.
        -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Visibility="{x:Bind ViewModel.HasInProgress, Mode=OneWay}">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="In progress" />
            <ListView
                Margin="-16,4,-16,0"
                AutomationProperties.AutomationId="InProgressList"
                AutomationProperties.Name="Builds in progress"
                IsItemClickEnabled="True"
                ItemClick="InProgress_ItemClick"
                ItemsSource="{x:Bind ViewModel.InProgress, Mode=OneTime}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionViewModel">
                        <Grid
                            Padding="0,12"
                            AutomationProperties.AutomationId="{x:Bind ActiveRowId, Mode=OneTime}"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ImageIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Source="{x:Bind h:Bind.ServiceIcon(Service), Mode=OneTime}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--  State: icon + words, never colour alone.  -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="&#xEA39;"
                                            Visibility="{x:Bind HasEndedWithError, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            Visibility="{x:Bind HasEndedWithNotice, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ServiceName, Mode=OneTime}" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="·" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="ActiveBuildStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource SecondaryCaptionStyle}"
                                            Text="{x:Bind ActiveStatus, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryCaptionStyle}"
                                        Text="{x:Bind StepDetail, Mode=OneWay}"
                                        Visibility="{x:Bind IsBuilding, Mode=OneWay}" />
                                </Grid>
                                <ProgressBar
                                    AutomationProperties.Name="Build progress"
                                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                    Maximum="{x:Bind ProgressMaximum, Mode=OneWay}"
                                    Visibility="{x:Bind IsBuilding, Mode=OneWay}"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="{x:Bind ResultMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind h:Bind.Collapsed(IsBuilding), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind ActiveCancelId, Mode=OneTime}"
                                    AutomationProperties.Name="Cancel build"
                                    Command="{x:Bind BuildCancelCommand}"
                                    Content="Cancel"
                                    Visibility="{x:Bind IsBuilding, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind ActiveDismissId, Mode=OneTime}"
                                    Command="{x:Bind DismissFromBuildsCommand}"
                                    Content="Dismiss"
                                    Visibility="{x:Bind h:Bind.Collapsed(IsBuilding), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
            <local:TtsHowTo />
        </Border>

        <StackPanel Grid.Row="3">
            <InfoBar
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="BuildsError"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                Severity="Error"
                Title="Couldn't list your builds" />

            <!--  A damaged build.json is named here and left out of the list; it never stops the page.  -->
            <InfoBar
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="BuildsDamaged"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasDamagedBuilds, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasDamagedBuilds, Mode=OneWay}"
                Message="{x:Bind ViewModel.DamagedBuilds, Mode=OneWay}"
                Severity="Warning"
                Title="Damaged builds aren't listed. Build these collections again to list them:" />
        </StackPanel>

        <ListView
            Grid.Row="4"
            Margin="-16,8,-16,0"
            Padding="0,0,0,24"
            AutomationProperties.AutomationId="BuildsList"
            AutomationProperties.Name="Builds"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneTime}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
            <ListView.Header>
                <TextBlock
                    Margin="16,0,16,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Finished"
                    Visibility="{x:Bind ViewModel.HasInProgress, Mode=OneWay}" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BuildItemViewModel">
                    <StackPanel Padding="0,12" Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7B8;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="{x:Bind Details, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <!--  Export status: icon + words, never colour alone.  -->
                                <StackPanel
                                    Margin="0,4,0,0"
                                    AutomationProperties.AutomationId="BuildExportStatus"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;"
                                        Visibility="{x:Bind IsExportedToTts, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xEA3A;"
                                        Visibility="{x:Bind IsNotExported, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource SecondaryCaptionStyle}"
                                        Text="{x:Bind ExportStatus, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="{x:Bind CopyStatus, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind ExportButtonId, Mode=OneTime}"
                                    Command="{x:Bind ExportToTtsCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xEDE1;" />
                                        <TextBlock Text="Export to TTS" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind MoreButtonId, Mode=OneTime}"
                                    AutomationProperties.Name="More"
                                    ToolTipService.ToolTip="More">
                                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="OpenBuildFolder"
                                                Command="{x:Bind OpenFolderCommand}"
                                                Text="Open folder">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE838;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="CopyBuildLua"
                                                Command="{x:Bind CopyLuaCommand}"
                                                Text="Copy Lua script"
                                                ToolTipService.ToolTip="Advanced: paste it into an object's Scripting tab in Tabletop Simulator instead of exporting">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <local:ExportResultBar Margin="36,0,0,0" ViewModel="{x:Bind ExportState, Mode=OneTime}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="4"
            MaxWidth="420"
            Margin="0,64,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE7B8;" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No builds yet" />
            <TextBlock
                AutomationProperties.AutomationId="BuildsEmptyText"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Finished music players show up here, so you can export them to Tabletop Simulator again without rebuilding. Open a collection and choose Build for Tabletop Simulator."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="GoToCollections"
                Click="GoToCollections_Click"
                Content="Browse collections" />
        </StackPanel>
    </Grid>
</Page>
