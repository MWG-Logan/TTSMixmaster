<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    setup.exe: a WiX Burn bundle that installs the signed per-user MSI with no UAC prompt.
      dotnet build installer/bundle/TTSMixmaster.Bundle.wixproj -c Release -p:InstallerPlatform=x64
        -p:AppPublishDir=<publish folder> -p:PerUserMsi=<signed TTSMixmaster.PerUser.msi>
  -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>TTSMixmaster.Setup</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UpgradeCode>4443E3E9-352C-43A7-94E0-BE78A895233C</UpgradeCode>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir);PerUserMsi=$(PerUserMsi);UpgradeCode=$(UpgradeCode)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="CheckPerUserMsi" BeforeTargets="Build">
    <Error Condition="'$(PerUserMsi)' == '' or !Exists('$(PerUserMsi)')"
           Text="PerUserMsi must point at the built (and, for releases, signed) TTSMixmaster.PerUser.msi. Got '$(PerUserMsi)'." />
  </Target>

  <Import Project="..\Installer.targets" />
</Project>
