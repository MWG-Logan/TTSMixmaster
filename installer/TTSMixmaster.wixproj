<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Per-machine MSI (C:\Program Files\TTSMixmaster). Build with:
      dotnet build installer/TTSMixmaster.wixproj -c Release -p:InstallerPlatform=x64 -p:AppPublishDir=<publish folder>
    scripts/package-release.ps1 does this for you. Version comes from Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>TTSMixmaster</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Stable since the first (Python) MSI: keeps MajorUpgrade working across releases. -->
    <UpgradeCode>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</UpgradeCode>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir);Scope=perMachine;UpgradeCode=$(UpgradeCode)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TTSMixmaster.wxs" />
  </ItemGroup>

  <Import Project="Installer.targets" />
</Project>
