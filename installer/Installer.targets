<Project>
  <!-- Shared settings and guards for the installer projects. -->
  <PropertyGroup>
    <!--
      ICE03 rejects the LCIDs of a few WinUI .mui satellites (gd-GB 1169, mi-NZ 1153,
      ug-CN 1152) because its language table predates them. They are valid Windows LCIDs.
    -->
    <SuppressIces>$(SuppressIces);ICE03</SuppressIces>
  </PropertyGroup>

  <Target Name="CheckInstallerInputs" BeforeTargets="Build">
    <Error Condition="'$(AppPublishDir)' == '' or !Exists('$(AppPublishDir)\TTSMixmaster.exe')"
           Text="AppPublishDir must point at the App publish folder containing TTSMixmaster.exe. Got '$(AppPublishDir)'." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+$'))"
           Text="Version must be MAJOR.MINOR.PATCH (set in Directory.Build.props). Got '$(Version)'." />
  </Target>
</Project>
