<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Per-user MSI (%LOCALAPPDATA%\Programs\TTSMixmaster, no admin rights). Not released on its
    own: it is signed and then embedded in the setup.exe bundle (installer/bundle).
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>TTSMixmaster.PerUser</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Distinct from the per-machine MSI so the two install contexts never upgrade each other. -->
    <UpgradeCode>B881E6CF-D5B4-49B4-8EC6-990BB288B096</UpgradeCode>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir);Scope=perUser;UpgradeCode=$(UpgradeCode)</DefineConstants>
    <!--
      Per-user files under the profile use file KeyPaths (ICE38/ICE91) and harvested subfolders
      have no RemoveFolder rows (ICE64). That's the normal shape of a per-user app install;
      Windows Installer still removes the files and the folders it created on uninstall.
    -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TTSMixmaster.wxs" />
  </ItemGroup>

  <Import Project="..\Installer.targets" />
</Project>
