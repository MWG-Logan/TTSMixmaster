<?xml version="1.0" encoding="UTF-8"?>
<!--
  TTSMixmaster MSI. One source, two packages:

    TTSMixmaster.wixproj          Scope=perMachine  -> C:\Program Files\TTSMixmaster      (released as the .msi)
    peruser/*.PerUser.wixproj     Scope=perUser     -> %LOCALAPPDATA%\Programs\TTSMixmaster (embedded in setup.exe)

  Both install the whole self-contained publish folder (AppPublishDir), harvested at build
  time with the WiX 5 <Files> element, plus Start Menu and Desktop shortcuts.

  Preprocessor variables (set by the .wixproj files):
    Version        MAJOR.MINOR.PATCH from Directory.Build.props
    AppPublishDir  the App publish folder (with yt-dlp/ffmpeg already added)
    Scope          perMachine | perUser
    UpgradeCode    stable per scope; never change it or upgrades stop working
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="TTSMixmaster"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Morningwood Gaming LLC"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="$(var.Scope)">

    <MajorUpgrade DowngradeErrorMessage="A newer version of TTSMixmaster is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.AppPublishDir)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MWG-Logan/TTSMixmaster" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <Feature Id="ProductFeature" Title="TTSMixmaster" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>

  <Fragment>
<?if $(var.Scope) = "perUser" ?>
    <!-- Per-user: no admin rights, the per-user equivalent of Program Files. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TTSMixmaster" />
      </Directory>
    </StandardDirectory>
<?else?>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="TTSMixmaster" />
    </StandardDirectory>
<?endif?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TTSMixmaster" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- Everything dotnet publish produced, plus the bundled yt-dlp/ffmpeg. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppPublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="Shortcuts">
      <!-- Start Menu shortcut; an HKCU registry value is the KeyPath (shortcut folders are per-user data to ICE). -->
      <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder">
        <Shortcut Id="StartMenuShortcut"
                  Name="TTSMixmaster"
                  Target="[INSTALLFOLDER]TTSMixmaster.exe"
                  Description="Turn music playlists into Tabletop Simulator music players"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\TTSMixmaster" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut"
                  Name="TTSMixmaster"
                  Target="[INSTALLFOLDER]TTSMixmaster.exe"
                  Description="Turn music playlists into Tabletop Simulator music players"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\TTSMixmaster" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
<?if $(var.Scope) = "perUser" ?>
      <!-- Per-user installs live in the profile: remove the folders we created on uninstall (ICE64). -->
      <Component Id="RemoveUserFolders" Directory="INSTALLFOLDER">
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\TTSMixmaster" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
